# Local development defaults to a database in the current directory.
VINYL_API_DATABASE_URL=sqlite:///./vinyl_api_dev.db

# Set this in deployed environments to protect write endpoints.
VINYL_API_KEY=

# Defaults to "local", which allows running without VINYL_API_KEY set.
# Any other value (e.g. "production") makes VINYL_API_KEY mandatory at
# startup -- the app refuses to boot without it, instead of failing open.
VINYL_API_ENV=local
